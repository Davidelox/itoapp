{
  "expo": {
    "name": "ito",
    "slug": "ito",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/brand/ito-icono-app-1024.png",
    "scheme": "ito",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#7B2433",
        "foregroundImage": "./assets/brand/ito-android-foreground-1024.png",
        "monochromeImage": "./assets/brand/ito-android-monochrome-1024.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.davidelox.ito",
      "versionCode": 1
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/ito-favicon-48.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF7E9",
          "image": "./assets/brand/ito-splash-1024.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#1C1012",
            "image": "./assets/brand/ito-splash-crema-1024.png"
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#7B2433"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ito usa tu ubicación solo para centrar el mapa donde estás y colocar un sitio. Nunca se guarda ni se envía.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ito necesita acceder a tus fotos para que elijas tu foto de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.davidelox.ito",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "extra": {
      "eas": {
        "projectId": "8765b6f6-7ec4-4bd1-a2a7-a4c8a39845bb"
      }
    },
    "owner": "davidelodax",
    "updates": {
      "url": "https://u.expo.dev/8765b6f6-7ec4-4bd1-a2a7-a4c8a39845bb"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
